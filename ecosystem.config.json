{
  "apps": [
    {
      "name": "url-shortener-backend",
      "script": "./server.js",
      "exec_mode": "fork",
      "instances": 1,
      "watch": true,
      "ignore_watch": ["node_modules", "logs", ".git"],
      "autorestart": true,
      "restart_delay": 5000,
      "max_restarts": 10,
      "kill_timeout": 3000,
      "env": {
        "NODE_ENV": "development",
        "PORT": 3001,
        "CORS_ORIGIN": "http://localhost:3000,http://127.0.0.1:3000,https://shortener.codingyari.com",
        "FRONTEND_URL": "http://localhost:3000"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 2121,
        "CORS_ORIGIN": "https://shortener.codingyari.com,http://localhost:3000",
        "FRONTEND_URL": "https://shortener.codingyari.com"
      },
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
